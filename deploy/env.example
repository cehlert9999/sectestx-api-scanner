# /etc/oas-audit/env — chmod 600
OAS_AUDIT_HOST=127.0.0.1
OAS_AUDIT_PORT=6010
# Nur diese Ursprünge dürfen den Dienst aus dem Browser aufrufen
OAS_AUDIT_ALLOWED_ORIGINS=https://sectestx.leanofy.de,https://leanofy.de,https://www.leanofy.de
# openssl rand -hex 32 — Signaturen überleben damit einen Neustart
OAS_AUDIT_SECRET=
# Hinter Nginx: echte Client-IP aus X-Forwarded-For lesen
OAS_AUDIT_TRUST_PROXY=1
OAS_AUDIT_SCANS_PER_HOUR=5
OAS_AUDIT_SCANS_PER_DAY=20
OAS_AUDIT_GLOBAL_PER_DAY=500
